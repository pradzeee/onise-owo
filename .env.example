# ==============================================================================
# Oníṣẹ́ ọwọ́ — Environment Variables (Step 1: Setup & Login)
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Postgres + PostGIS + Auth + Storage + Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Cryptographic HMAC secret for hashing phone numbers / rate-limit keys ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_HMAC_SECRET=replace-with-at-least-32-byte-random-hex-secret

# --- Cloudflare Turnstile CAPTCHA ---
# Leave empty ONLY in local development to use the built-in dev CAPTCHA bypass widget.
# In production, Turnstile is strictly enforced.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Supabase Auth Send SMS Hook (Nigerian SMS Provider) ---
# Configured as Edge Function secrets in Supabase (`supabase secrets set ...`)
# SMS_PROVIDER=termii  # or africas_talking | log_stub (dev only, never logs phone/code)
# SEND_SMS_HOOK_SECRET=v1,whsec_...
# TERMII_API_KEY=
# TERMII_SENDER_ID=OniseOwo
# TERMII_CHANNEL=dnd
# AFRICAS_TALKING_API_KEY=
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_SENDER_ID=OniseOwo

# --- Dev OTP Preview (LOCAL DEVELOPMENT ONLY, ignored when NODE_ENV=production) ---
# Set to "true" ONLY if you want to test the login UI locally without a live Supabase Auth SMS hook.
# For full Supabase Auth + RLS verification, leave this unset or "false".
NEXT_PUBLIC_ENABLE_DEV_CAPTCHA=true

# ==============================================================================
# Step 2: Artisan Onboarding, NIN Verification, Paystack Payouts & Guarantor SMS
# ==============================================================================

# --- Paystack (Nigeria payouts & subaccounts; NEVER store bank details in DB) ---
# Leave empty ONLY in local development to use the dev mock recipient code generator.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLATFORM_COMMISSION_PERCENT=15

# --- Licensed Nigerian NIN Verification Provider (Face Match + Liveness) ---
# Supported: "dojah" | "prembly" | "dev_mock" (dev_mock is forbidden in production)
NIN_VERIFICATION_PROVIDER=dev_mock
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://api.dojah.io
PREMBLY_API_KEY=
PREMBLY_APP_ID=
PREMBLY_BASE_URL=https://api.prembly.com

# --- Server-side Nigerian SMS Dispatcher (for Guarantor verification links & OTPs) ---
# Supported: "termii" | "africas_talking" | "dev_mock" (dev_mock is forbidden in production)
APP_SMS_PROVIDER=dev_mock
TERMII_API_KEY=
TERMII_SENDER_ID=OniseOwo
TERMII_CHANNEL=dnd
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=OniseOwo

# ==============================================================================
# Step 3: Web Push Notifications (VAPID) & Scheduled Cron Jobs
# Generate VAPID keys with: npx web-push generate-vapid-keys
# ==============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@oniseowo.ng

# Secret bearer token protecting /api/cron/* endpoints (Vercel Cron / Supabase pg_cron)
CRON_SECRET=replace-with-random-cron-secret

# ==============================================================================
# Step 6: Payments (Paystack Webhook, First-Time Customer Cap & Reconciliation)
# ==============================================================================
# Maximum job value in WHOLE KOBO for first-time customers until they have 1 confirmed job.
# Default: 5000000 kobo (₦50,000). Adjust as needed for your risk policy.
FIRST_TIME_CUSTOMER_MAX_JOB_KOBO=5000000

